<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "binaries": the first signing round of a Cairn release.

  release.yml uploads build\sign\binaries (written by build_release.ps1 -StageOnly -SigningDir)
  as a GitHub artifact, which is a zip file: Cairn's own programs and libraries, the engine
  module under its cargo name optimizer_engine.dll (SignPath signs .exe and .dll files) and the
  uninstaller of the setup as uninstaller/uninst.exe. SignPath keeps its own copy of this
  configuration; this file records it for review.

  Every signed file must name the product Cairn and carry the release version, which the action
  passes as the parameter "version". The Rust and CMake builds write these strings as they are.
  Inno Setup pads the strings of its uninstaller: ProductName is "Cairn" followed by spaces to
  60 characters, ProductVersion the version followed by spaces to 50 characters. How SignPath
  compares product-name and product-version is not documented; the first test-signing request
  decides whether the restriction of uninstaller/uninst.exe must carry the padding. If it must,
  its attributes become "Cairn" with 55 spaces and "${version}" with the spaces that make 50
  characters; build_release.ps1 -FinalizeOnly writes the exact strings of each build into
  build\dist\signpath-metadata.txt.

  The parameter has no default, so a request without a version cannot be signed.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Cairn" product-version="${version}">
      <include path="Cairn.exe" />
      <include path="optctl.exe" />
      <include path="cairn-maintenance.exe" />
      <for-each>
        <authenticode-sign description="Cairn" description-url="https://github.com/Dray973/Cairn" />
      </for-each>
    </pe-file-set>
    <directory path="app/optimizer/native">
      <pe-file path="optimizer_engine.dll" product-name="Cairn" product-version="${version}">
        <authenticode-sign description="Cairn" description-url="https://github.com/Dray973/Cairn" />
      </pe-file>
      <pe-file path="optimizer_telemetry.dll" product-name="Cairn" product-version="${version}">
        <authenticode-sign description="Cairn" description-url="https://github.com/Dray973/Cairn" />
      </pe-file>
    </directory>
    <directory path="uninstaller">
      <pe-file path="uninst.exe" product-name="Cairn" product-version="${version}">
        <authenticode-sign description="Cairn" description-url="https://github.com/Dray973/Cairn" />
      </pe-file>
    </directory>
  </zip-file>
</artifact-configuration>
